{
  "name": "dsh-exa-tools",
  "version": "0.1.0",
  "description": "Exa web search and fetch tools for DeepSeek Harness: exa_search and exa_fetch. Works without an API key on Exa's free hosted MCP endpoint; set a key on the plugin page to use the official Exa API.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "scripts",
    "icon.svg",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "README.md",
    "README.en-US.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "exa",
    "web-search",
    "search",
    "fetch",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vikrant-Aleph/dsh-exa-tools.git"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs --rest",
    "smoke:api": "node scripts/smoke.mjs --api",
    "test:apply": "node scripts/apply-test.mjs",
    "test:client": "node scripts/client-test.mjs"
  }
}
